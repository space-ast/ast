#pragma once
#define AST_VERSION "${VERSION}"
#define AST_VERSION_MAJOR ${VERSION_MAJOR}
#define AST_VERSION_MINOR ${VERSION_MINOR}
#define AST_VERSION_ALTER ${VERSION_ALTER}


// 下面是项目编译期配置宏，用于在编译期启动或禁用项目的特定功能，你可以根据需要定义或注释掉这些宏
// 有些宏定义会改变项目的二进制接口(ABI)，使用不同配置宏编译的库文件互不兼容
// 请确保整个项目使用一致的配置，避免混用不同配置宏的库文件和头文件


